<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="480.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vvalue="1.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="64.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" prefHeight="42.0" promptText="Type a message…"
                   onAction="#handleUserInput" AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="100.0" />
        <Button fx:id="sendButton" prefHeight="42.0" prefWidth="76.0" text="Send"
                AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0"
                mnemonicParsing="false" onAction="#handleUserInput" />
    </children>
</AnchorPane>
