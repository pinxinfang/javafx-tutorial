<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="10.0"
         minHeight="-Infinity" prefWidth="400.0" stylesheets="@../css/dialog-box.css"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" text="Message" styleClass="dialog-label" wrapText="true"
               minWidth="0.0" minHeight="-Infinity">
            <HBox.margin>
                <Insets left="4.0" right="4.0" />
            </HBox.margin>
        </Label>
        <ImageView fx:id="displayPicture" fitWidth="70.0" fitHeight="70.0" preserveRatio="true" />
    </children>
    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
    </padding>
</fx:root>
